# ─────────────────────────────────────────────────────────────
#  СКОПИРУЙ ЭТОТ ФАЙЛ КАК .env  и заполни значения.
#  cp .env.example .env
#  На Windows:  copy .env.example .env
#
#  .env в гити не попадает. Реальные ключи сюда НЕ клади.
# ─────────────────────────────────────────────────────────────


# ═══ TELEGRAM ═══════════════════════════════════════════════

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Твой числовой id (отрицательное число). Узнать: напиши @userinfobot
# Кому бот имеет право писать. Всё остальное — игнорируется.
TELEGRAM_ADMIN_CHAT_ID=


# ═══ LLM (любой OpenAI-совместимый API) ═════════════════════
#
#  НЕ ПРИВЯЗЫВАЕМСЯ К КОНКРЕТНОМУ ПРОВАЙДЕРУ.
#  Подойдёт что угодно, что говорит на OpenAI-совместимом API.
#
#  Примеры baseUrl:
#    DeepSeek   →  https://api.deepseek.com/v1
#    xAI Grok   →  https://api.x.ai/v1
#    OpenRouter →  https://openrouter.ai/api/v1
#    Локальный  →  http://localhost:11434/v1   (Ollama)

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# ═══ РЫНОК ══════════════════════════════════════════════════

BYBIT_CATEGORY=linear
BYBIT_SYMBOL=BTCUSDT

# Сколько минут сделок держим в памяти
WINDOW_MINUTES=10
# На сколько секунд назад смотрим для всплеска цены
SPIKE_WINDOW_SECONDS=60
# Порог всплеска цены, доля (0.003 = 0.3%)
SPIKE_PCT=0.003
# Во сколько раз объём должен превысить средний
VOL_MULT=3
# Как часто пробуем плановый анализ, мс
PLANNED_INTERVAL_MS=60000
# Пауза между запросами к LLM, мс
COOLDOWN_MS=60000


# ═══ ПРОМПТЫ ════════════════════════════════════════════════

PROMPTS_PATH=./prompts.yml


# ═══ РЕЖИМ ОТВЕТА ═══════════════════════════════════════════
#  expert    — коротко, для того кто шарит
#  beginner  — подробно, для новичка
#  Позже будет переключаться в Telegram и храниться в базе.

RESPONSE_MODE=beginner


# ═══ ПРОЧИЕ НАСТРОЙКИ ═══════════════════════════════════════

PORT=3000

# Подробный лог всего подряд или только важное
LOG_LEVEL=debug

# Не больше этого количества запросов к LLM в сутки.
# Страховка от того, чтобы баг слил весь баланс.
LLM_DAILY_LIMIT=200

# Сколько раз повторять запрос к LLM при ошибке
LLM_MAX_RETRIES=2

# Данные старше этого считаются протухшими, триггеры молчат
STALE_AFTER_MS=10000
