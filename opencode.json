{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "*.log",
      "settings.yml",
      ".env",
      ".production.env",
      ".agents",
      ".claude",
      ".windsurf"
    ]
  },
  "provider": {
    "allow_fallbacks": {
      "enabled": false
    }
  },
  "permission": {
    "websearch": "deny",
    "webfetch": "deny"
  }
}
